# GitHub Container Registry deployment
GHCR_REPOSITORY=owner/repo
IMAGE_TAG=latest

# Frontend
VITE_APP_MODE=demo
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_BASE_PATH=/

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=tictactoe
MYSQL_USER=ttt_user
MYSQL_PASSWORD=replace-with-a-strong-db-password
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT_PUBLISHED=6379

# Backend / Spring
DATABASE_URL=jdbc:mysql://mysql:3306/tictactoe?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ttt_user
DB_PASSWORD=replace-with-a-strong-db-password
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
BACKEND_PORT=8080
FRONTEND_PORT=80
